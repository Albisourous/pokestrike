{
  "name": "pokestrike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "mkdir -p node_modules/.cache && rolldown test/smoke.ts -f esm -p node -o node_modules/.cache/smoke.mjs && node node_modules/.cache/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
